# /var/www/xiaoci-phone/shared-server/.env
PORT=8791
HOST=127.0.0.1
SHARED_PHONE_DB=/var/www/xiaoci-phone/data/shared-phone.sqlite
SHARED_PHONE_MEDIA_DIR=/var/www/xiaoci-phone/data/media
SHARED_PHONE_MAX_MEDIA_BYTES=26214400
SHARED_PHONE_BACKUP_DIR=/var/www/xiaoci-phone/backups
SHARED_PHONE_BACKUP_KEEP=14

# Leave empty in production when the whole site is protected by Nginx Basic Auth.
# The API is bound to 127.0.0.1 and is not directly exposed to the internet.
SHARED_PHONE_TOKEN=

CORS_ORIGIN=https://phone.meimeibw.cc

WAKE_TIMEZONE=Asia/Shanghai
WAKE_ENGINE_INTERVAL_MS=900000
WAKE_QUIET_START_HOUR=1
WAKE_QUIET_END_HOUR=8
WAKE_COOLDOWN_MS=7200000
WAKE_LONG_SILENCE_MS=28800000
WAKE_RANDOM_MEAN_HOURS=10
WAKE_SIGNAL_TTL_MS=14400000
