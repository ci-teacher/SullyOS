[Unit]
Description=Xiaoci Phone Work Login
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/xiaoci-phone-auth.env
ExecStart=/usr/bin/node /var/www/xiaoci-phone/deploy/xiaoci-phone/auth-server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
