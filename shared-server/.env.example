# Shared phone server
PORT=8787
HOST=127.0.0.1
SHARED_PHONE_DB=./data/shared-phone.sqlite
SHARED_PHONE_MEDIA_DIR=./data/media
SHARED_PHONE_MAX_MEDIA_BYTES=26214400
SHARED_PHONE_BACKUP_DIR=./backups
SHARED_PHONE_BACKUP_KEEP=14
SHARED_PHONE_TOKEN=replace-with-a-long-random-secret
CORS_ORIGIN=https://phone.example.com

# Wake Engine
WAKE_TIMEZONE=Asia/Shanghai
WAKE_ENGINE_INTERVAL_MS=900000
WAKE_QUIET_START_HOUR=1
WAKE_QUIET_END_HOUR=8
WAKE_COOLDOWN_MS=7200000
WAKE_LONG_SILENCE_MS=28800000
WAKE_RANDOM_MEAN_HOURS=10
WAKE_SIGNAL_TTL_MS=14400000

# Frontend (Vite)
VITE_SHARED_API_BASE=https://phone.example.com/shared-api
VITE_SHARED_API_TOKEN=replace-with-the-same-long-random-secret

VITE_SHARED_PHONE_MODE=true
